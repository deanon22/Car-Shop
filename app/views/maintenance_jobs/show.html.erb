<div class="max-w-3xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Maintenance Details</h1>
      <p class="text-sm text-gray-500 mt-1">
        <%= @car.year %> <%= @car.make %> <%= @car.model %> &bull; <%= @maintenance_job.date.strftime("%B %d, %Y") %>
      </p>
    </div>
    <div class="flex space-x-3 items-center">
        <%= link_to 'Edit Job', edit_car_maintenance_job_path(@car, @maintenance_job), class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" %>
        <%= button_to 'Delete Job', [@car, @maintenance_job], method: :delete, data: { turbo_confirm: "Are you sure you want to delete this maintenance job from #{@maintenance_job.date.strftime('%B %d, %Y')}?" }, form: { class: "inline" }, class: "inline-flex items-center px-4 py-2 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700" %>
        <%= link_to 'Back to Car', car_path(@car), class: "inline-flex items-center px-4 py-2 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-primary-600 hover:bg-primary-700" %>
    </div>
  </div>

  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="p-6 border-b border-gray-100">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Job Overview</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <p class="text-sm font-medium text-gray-500">Description</p>
          <p class="mt-1 text-gray-900"><%= @maintenance_job.description %></p>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-500">Mileage</p>
          <p class="mt-1 text-gray-900"><%= number_with_delimiter(@maintenance_job.mileage) %> miles</p>
        </div>
      </div>
    </div>

    <div class="px-6 py-4 bg-gray-50 border-b border-gray-100 flex justify-between items-center">
      <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-wider">Cost Breakdown</h3>
       <%= link_to new_maintenance_job_part_path(@maintenance_job), class: "text-sm text-primary-600 font-medium hover:text-primary-900" do %>
         + Add Part
       <% end %>
    </div>
    
    <table class="w-full text-left">
      <thead class="bg-white">
        <tr>
          <th class="px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">Item</th>
          <th class="px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider text-right">Cost</th>
          <th class="px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 bg-white">
        <tr>
          <td class="px-6 py-4 text-sm text-gray-900">Base Labor / Service</td>
          <td class="px-6 py-4 text-sm text-gray-900 text-right"><%= number_to_currency(@maintenance_job.price) %></td>
          <td class="px-6 py-4 text-right"></td>
        </tr>
        <% @maintenance_job.parts.each do |part| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 text-sm text-gray-900"><%= part.name %></td>
            <td class="px-6 py-4 text-sm text-gray-900 text-right"><%= number_to_currency(part.price) %></td>
            <td class="px-6 py-4 text-right text-sm font-medium space-x-2">
              <%= link_to 'Edit', edit_maintenance_job_part_path(@maintenance_job, part), class: 'text-amber-600 hover:text-amber-900' %>
              <%= button_to 'Delete', maintenance_job_part_path(@maintenance_job, part), method: :delete, data: { turbo_confirm: "Are you sure you want to remove the part: #{part.name}?" }, form: { class: 'inline' }, class: 'text-red-600 hover:text-red-900 bg-transparent border-none p-0 cursor-pointer' %>
            </td>
          </tr>
        <% end %>
        <tr class="bg-gray-50">
          <td class="px-6 py-4 text-sm font-bold text-gray-900">Total</td>
          <td class="px-6 py-4 text-sm font-bold text-gray-900 text-right"><%= number_to_currency(@maintenance_job.total_cost) %></td>
          <td class="px-6 py-4"></td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-semibold text-gray-900">Receipts</h3>
      <%= form_with(url: attach_receipts_car_maintenance_job_path(@car, @maintenance_job), local: true, class: "flex items-center space-x-2") do |f| %>
        <%= f.file_field :receipts, name: "maintenance_job[receipts][]", multiple: true, required: true, class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-primary-50 file:text-primary-700 hover:file:bg-primary-100" %>
        <%= f.submit "Upload", class: "inline-flex items-center px-4 py-2 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 cursor-pointer whitespace-nowrap" %>
      <% end %>
    </div>

    <% if @maintenance_job.receipts.attached? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <% @maintenance_job.receipts.each do |receipt| %>
          <div class="group relative rounded-lg overflow-hidden border border-gray-200 bg-gray-50">
            <% if receipt.variable? %>
              <%= image_tag receipt.variant(resize_to_limit: [400, 400]), class: "w-full h-48 object-cover" %>
            <% elsif receipt.previewable? %>
              <%= image_tag receipt.preview(resize_to_limit: [400, 400]), class: "w-full h-48 object-cover" %>
            <% else %>
              <div class="w-full h-48 flex flex-col items-center justify-center bg-gray-100 text-gray-400 gap-2">
                <svg class="h-10 w-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                <span class="text-xs"><%= receipt.content_type %></span>
              </div>
            <% end %>

            <div class="p-3 bg-white border-t border-gray-100">
              <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-gray-500 truncate mr-2" title="<%= receipt.filename %>">
                  <%= receipt.filename %>
                </span>
                <div class="flex items-center space-x-2">
                  <%= link_to rails_blob_path(receipt, disposition: "attachment"), class: "text-primary-600 hover:text-primary-900", title: "Download" do %>
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a2 2 0 002 2h12a2 2 0 002-2v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                  <% end %>
                  <%= link_to rails_blob_path(receipt), target: "_blank", class: "text-gray-500 hover:text-gray-900", title: "View" do %>
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                  <% end %>
                  <%= button_to delete_receipt_car_maintenance_job_path(@car, @maintenance_job, attachment_id: receipt.id),
                        method: :delete,
                        data: { turbo_confirm: "Delete this receipt?" },
                        form: { class: "inline" },
                        class: "text-red-400 hover:text-red-600 bg-transparent border-none p-0 cursor-pointer",
                        title: "Delete" do %>
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-500 italic">No receipts uploaded yet.</p>
    <% end %>
  </div>
</div>
