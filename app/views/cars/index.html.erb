<div class="w-full">
  <h1 class="text-2xl font-bold mb-4">Cars</h1>
  <%= link_to 'New Car', new_car_path, class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
  <div class="mt-4">
    <table class="table-auto w-full">
      <thead>
        <tr>
          <th class="px-4 py-2">Make</th>
          <th class="px-4 py-2">Model</th>
          <th class="px-4 py-2">Year</th>
          <th class="px-4 py-2">Color</th>
          <th class="px-4 py-2"></th>
        </tr>
      </thead>
      <tbody>
        <% @cars.each do |car| %>
          <tr>
            <td class="border px-4 py-2"><%= car.make %></td>
            <td class="border px-4 py-2"><%= car.model %></td>
            <td class="border px-4 py-2"><%= car.year %></td>
            <td class="border px-4 py-2"><%= car.color %></td>
            <td class="border px-4 py-2">
              <%= link_to 'Show', car, class: "text-blue-500 hover:underline" %>
              <%= link_to 'Edit', edit_car_path(car), class: "text-yellow-500 hover:underline" %>
              <%= link_to 'Destroy', car, method: :delete, data: { confirm: 'Are you sure?' }, class: "text-red-500 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
