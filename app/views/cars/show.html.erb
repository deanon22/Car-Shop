<div class="w-full">
  <h1 class="text-2xl font-bold mb-4"><%= @car.year %> <%= @car.make %> <%= @car.model %></h1>
  <p><strong>Color:</strong> <%= @car.color %></p>

  <h2 class="text-xl font-bold mt-8 mb-4">Maintenance Jobs</h2>
  <%= link_to 'New Maintenance Job', new_car_maintenance_job_path(@car), class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>

  <div class="mt-4">
    <table class="table-auto w-full">
      <thead>
        <tr>
          <th class="px-4 py-2">Date</th>
          <th class="px-4 py-2">Mileage</th>
          <th class="px-4 py-2">Description</th>
          <th class="px-4 py-2">Price</th>
          <th class="px-4 py-2"></th>
        </tr>
      </thead>
      <tbody>
        <% @car.maintenance_jobs.each do |job| %>
          <tr>
            <td class="border px-4 py-2"><%= job.date.strftime("%B %d, %Y") %></td>
            <td class="border px-4 py-2"><%= job.mileage %></td>
            <td class="border px-4 py-2"><%= job.description %></td>
            <td class="border px-4 py-2"><%= number_to_currency(job.price) %></td>
            <td class="border px-4 py-2">
              <%= link_to 'Show', [@car, job], class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-1 px-3 rounded text-xs mr-2 inline-block" %>
              <%= link_to 'Edit', edit_car_maintenance_job_path(@car, job), class: "bg-yellow-500 hover:bg-yellow-700 text-white font-bold py-1 px-3 rounded text-xs mr-2 inline-block" %>
              <%= button_to 'Delete', [@car, job], method: :delete, data: { turbo_confirm: "Are you sure you want to delete the maintenance job from #{job.date.strftime('%B %d, %Y')}?" }, form: { class: 'inline' }, class: "bg-red-500 hover:bg-red-700 text-white font-bold py-1 px-3 rounded text-xs inline-block" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= link_to 'Edit Car', edit_car_path(@car), class: "text-yellow-500 hover:underline mt-4 inline-block mr-4" %>
  <%= button_to 'Delete Car', @car, method: :delete, data: { turbo_confirm: "Are you sure you want to delete your #{@car.year} #{@car.make} #{@car.model}?" }, form: { class: "inline-block mr-4" }, class: "text-red-500 hover:underline mt-4" %>
  <%= link_to 'Back to Cars', cars_path, class: "text-blue-500 hover:underline mt-4 inline-block" %>
</div>
