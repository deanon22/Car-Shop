<%= form_with(model: [ @maintenance_job, @part ], class: "space-y-6") do |form| %>
  <% if @part.errors.any? %>
    <div class="rounded-lg bg-red-50 p-4 border border-red-200">
      <h2 class="text-sm font-medium text-red-800"><%= pluralize(@part.errors.count, "error") %> prohibited this part from being saved:</h2>
      <ul class="mt-2 list-disc pl-5 space-y-1 text-sm text-red-700">
        <% @part.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :name, class: "appearance-none block w-full px-3 py-2 border border-gray-300 rounded-lg shadow-sm placeholder-gray-400 focus:outline-none focus:ring-primary-500 focus:border-primary-500 sm:text-sm" %>
  </div>

  <div>
    <%= form.label :price, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.number_field :price, step: 0.01, class: "appearance-none block w-full px-3 py-2 border border-gray-300 rounded-lg shadow-sm placeholder-gray-400 focus:outline-none focus:ring-primary-500 focus:border-primary-500 sm:text-sm" %>
  </div>

  <div class="flex items-center justify-end space-x-3 pt-4 border-t border-gray-100">
    <%= link_to 'Cancel', car_maintenance_job_path(@maintenance_job.car, @maintenance_job), class: "bg-white py-2 px-4 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500" %>
    <%= form.submit class: "cursor-pointer inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-lg text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500" %>
  </div>
<% end %>
