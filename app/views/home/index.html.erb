<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Good Morning, <%= current_user.email.split('@').first.capitalize %></h1>
      <p class="text-sm text-gray-500 mt-1">Here's an overview of your Garage and recent activity.</p>
    </div>
    
    <div class="mt-4 md:mt-0 flex space-x-3">
      <div class="relative" data-controller="dropdown" data-action="click@window->dropdown#hide">
        <button type="button" data-action="click->dropdown#toggle" class="bg-white border border-gray-300 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium shadow-sm hover:bg-gray-50 flex items-center">
          <%= @range_label %>
          <svg class="ml-2 h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        
        <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-48 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 z-50">
          <div class="py-1" role="menu" aria-orientation="vertical">
            <%= link_to "This Month", root_path(range: "this_month"), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{'bg-gray-50 font-semibold text-primary-600' if @range == 'this_month'}", role: "menuitem" %>
            <%= link_to "Last 3 Months", root_path(range: "last_3_months"), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{'bg-gray-50 font-semibold text-primary-600' if @range == 'last_3_months'}", role: "menuitem" %>
            <%= link_to "Last 6 Months", root_path(range: "last_6_months"), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{'bg-gray-50 font-semibold text-primary-600' if @range == 'last_6_months'}", role: "menuitem" %>
            <%= link_to "Last Year", root_path(range: "last_year"), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{'bg-gray-50 font-semibold text-primary-600' if @range == 'last_year'}", role: "menuitem" %>
            <%= link_to "All Time", root_path(range: "all_time"), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{'bg-gray-50 font-semibold text-primary-600' if @range == 'all_time'}", role: "menuitem" %>
          </div>
        </div>
      </div>

      <%= link_to root_path(range: @range, format: :csv), class: "bg-white border border-gray-300 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium shadow-sm hover:bg-gray-50 flex items-center" do %>
        <svg class="mr-2 h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        Export
      <% end %>
    </div>
  </div>

  <!-- Stats Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <!-- Stat Card 1: Total Spent -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
      <div class="flex items-center space-x-4">
        <div class="p-3 bg-purple-100 rounded-xl text-purple-600">
          <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <p class="text-2xl font-bold text-gray-900"><%= number_to_currency(@total_spent) %></p>
          <p class="text-sm text-gray-500">Total Spent</p>
        </div>
      </div>
    </div>

    <!-- Stat Card 2: Total Cars -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
      <div class="flex items-center space-x-4">
         <div class="p-3 bg-orange-100 rounded-xl text-orange-600">
          <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
        <div>
          <p class="text-2xl font-bold text-gray-900"><%= @total_cars %></p>
          <p class="text-sm text-gray-500">Total Cars</p>
        </div>
      </div>
    </div>

    <!-- Stat Card 3: Total Jobs -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
      <div class="flex items-center space-x-4">
        <div class="p-3 bg-pink-100 rounded-xl text-pink-600">
          <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <div>
          <p class="text-2xl font-bold text-gray-900"><%= @total_jobs %></p>
          <p class="text-sm text-gray-500">Maintenance Jobs</p>
        </div>
      </div>
    </div>
    
    <!-- Stat Card 4: Last Activity (Mock) -->
     <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
      <div class="flex items-center space-x-4">
        <div class="p-3 bg-primary-100 rounded-xl text-primary-600">
           <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <p class="text-2xl font-bold text-gray-900"><%= @recent_jobs.any? ? time_ago_in_words(@recent_jobs.first.created_at) : 'N/A' %></p>
          <p class="text-sm text-gray-500">Last Activity</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Charts Section -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Chart -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 lg:col-span-2">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-lg font-semibold text-gray-900">Cost History</h3>
        <button class="text-gray-400 hover:text-gray-600">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h.01M12 12h.01M19 12h.01M6 12a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0z" />
          </svg>
        </button>
      </div>
      <!-- Enhanced Bar Chart -->
      <div class="relative h-64 w-full bg-white rounded-lg flex items-end justify-between px-2 pb-0 overflow-hidden">
        <% @monthly_data.each do |data| %>
          <% height_percent = @max_monthly > 0 ? (data[:total] / @max_monthly * 85) : 0 %>
          <div class="flex-1 flex flex-col items-center group px-1 h-full justify-end">
            <!-- Value on transition -->
             <div class="absolute bottom-0 w-full max-w-[40px] bg-gradient-to-t from-primary-600 to-primary-400 transition-all duration-700 ease-out group-hover:from-primary-700 group-hover:to-primary-500 rounded-t-md shadow-sm" 
                  style="height: <%= height_percent == 0 && data[:total] > 0 ? 5 : height_percent %>%;">
                
                <!-- Enhanced Tooltip -->
                <div class="absolute -top-12 left-1/2 -translate-x-1/2 bg-gray-900 text-white text-[11px] font-bold py-1.5 px-3 rounded-lg opacity-0 group-hover:opacity-100 transition-all duration-200 pointer-events-none transform translate-y-2 group-hover:translate-y-0 shadow-xl z-20">
                  <div class="text-gray-400 text-[9px] uppercase tracking-wider mb-0.5"><%= data[:month] %></div>
                  <%= number_to_currency(data[:total]) %>
                  <!-- Triangle for tooltip -->
                  <div class="absolute top-full left-1/2 -translate-x-1/2 border-8 border-transparent border-t-gray-900"></div>
                </div>
             </div>
          </div>
        <% end %>

        <!-- Horizontal grid lines -->
        <div class="absolute inset-x-0 top-0 h-px bg-gray-100"></div>
        <div class="absolute inset-x-0 top-1/4 h-px bg-gray-50 pointer-events-none"></div>
        <div class="absolute inset-x-0 top-2/4 h-px bg-gray-50 pointer-events-none"></div>
        <div class="absolute inset-x-0 top-3/4 h-px bg-gray-50 pointer-events-none"></div>
      </div>
      
      <div class="flex justify-between text-[10px] font-medium text-gray-400 mt-4 px-2">
        <% @monthly_data.each do |data| %>
          <span class="flex-1 text-center"><%= data[:month].upcase %></span>
        <% end %>
      </div>
    </div>

    <!-- Spending per Car Chart -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
       <div class="flex items-center justify-between mb-6">
        <h3 class="text-lg font-semibold text-gray-900">Spending per Car</h3>
      </div>
      <div class="relative flex items-center justify-center h-56">
        <!-- CSS Donut Chart Mockup using real total -->
        <div class="w-40 h-40 rounded-full border-8 border-primary-500 flex items-center justify-center relative">
           <% colors = ['border-t-purple-500', 'border-r-orange-500', 'border-b-pink-500', 'border-l-blue-500'] %>
           <% @spending_by_car.each_with_index do |data, i| %>
             <div class="w-40 h-40 rounded-full border-8 border-transparent <%= colors[i % colors.length] %> absolute" style="transform: rotate(<%= i * 45 %>deg);"></div>
           <% end %>
           <div class="text-center">
             <p class="text-xl font-bold text-gray-900"><%= number_to_currency(@total_spent) %></p>
             <p class="text-xs text-gray-500">Filtered Total</p>
           </div>
        </div>
      </div>
      <div class="space-y-3 mt-4 overflow-y-auto max-h-48">
        <% @spending_by_car.each_with_index do |data, i| %>
          <% percentage = @total_spent > 0 ? (data[:total] / @total_spent * 100).round : 0 %>
          <% dot_colors = ['bg-purple-500', 'bg-orange-500', 'bg-pink-500', 'bg-blue-500'] %>
          <div class="flex items-center justify-between text-sm">
            <div class="flex items-center">
              <span class="w-3 h-3 rounded-full <%= dot_colors[i % dot_colors.length] %> mr-2"></span>
              <span class="text-gray-600 truncate max-w-[120px]" title="<%= data[:name] %>"><%= data[:name] %></span>
            </div>
            <span class="font-medium text-gray-900"><%= number_to_currency(data[:total]) %> (<%= percentage %>%)</span>
          </div>
        <% end %>
        <% if @spending_by_car.empty? %>
          <p class="text-sm text-gray-500 italic text-center">No data for this range.</p>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Recent Transactions / Jobs -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="p-6 border-b border-gray-100 flex items-center justify-between">
      <h3 class="text-lg font-semibold text-gray-900">Recent Maintenance Jobs</h3>
      <button class="text-gray-400 hover:text-gray-600">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h.01M12 12h.01M19 12h.01M6 12a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0z" />
        </svg>
      </button>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider">
            <th class="px-6 py-3 font-medium">Car</th>
            <th class="px-6 py-3 font-medium">Date</th>
            <th class="px-6 py-3 font-medium">Amount</th>
            <th class="px-6 py-3 font-medium">Description</th>
            <th class="px-6 py-3 font-medium">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% if @recent_jobs.any? %>
            <% @recent_jobs.each do |job| %>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center">
                    <div class="h-8 w-8 rounded-full bg-primary-100 flex items-center justify-center text-primary-600 font-bold text-xs">
                      <%= job.car.make[0] %>
                    </div>
                    <div class="ml-3">
                      <p class="text-sm font-medium text-gray-900"><%= "#{job.car.year} #{job.car.make} #{job.car.model}" %></p>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= job.date ? job.date.strftime("%d %b, %Y") : "No Date" %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                  <%= number_to_currency(job.total_cost) %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 truncate max-w-xs">
                  <%= job.description.truncate(30) if job.description %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <%= link_to "View", car_maintenance_job_path(job.car, job), class: "text-primary-600 hover:text-primary-900 bg-primary-50 px-3 py-1 rounded-full text-xs" %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="px-6 py-8 text-center text-gray-500">
                No recent jobs found. <a href="<%= new_car_path %>" class="text-primary-600 hover:underline">Add a car</a> or job to get started.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
