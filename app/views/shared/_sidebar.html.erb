<aside class="w-64 bg-gray-900 border-r border-gray-800 hidden md:block flex-shrink-0 transition-all duration-300 ease-in-out">
  <div class="h-full flex flex-col">
    <!-- Logo -->
    <div class="h-16 flex items-center px-6 border-b border-gray-800 bg-gray-900">
      <div class="flex items-center gap-3 text-white font-bold text-xl tracking-tight">
        <div class="p-1.5 bg-primary-600 rounded-lg shadow-lg shadow-primary-500/20">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
            <path d="M11 7h2v6h-2zm0 8h2v2h-2z"/>
          </svg>
        </div>
        <span>Monexa</span>
      </div>
    </div>

    <!-- Navigation -->
    <nav class="flex-1 overflow-y-auto py-6 px-4 space-y-1">
      <p class="px-2 text-xs font-semibold text-gray-500 uppercase tracking-wider mb-4">Menu</p>
      
      <%= link_to root_path, class: "group flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-colors duration-200 #{request.path == root_path ? 'bg-primary-600 text-white shadow-md' : 'text-gray-400 hover:bg-gray-800 hover:text-white'}" do %>
        <svg class="mr-3 h-5 w-5 transition-colors duration-200 #{request.path == root_path ? 'text-white' : 'text-gray-500 group-hover:text-gray-300'}" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
        </svg>
        Dashboard
      <% end %>

      <%= link_to "#", class: "group flex items-center px-3 py-2.5 text-sm font-medium text-gray-400 rounded-lg transition-colors duration-200 hover:bg-gray-800 hover:text-white" do %>
        <svg class="mr-3 h-5 w-5 text-gray-500 group-hover:text-gray-300 transition-colors duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        Analytics
      <% end %>

      <% if user_signed_in? %>
        <%= link_to cars_path, class: "group flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-colors duration-200 #{request.path.include?(cars_path) ? 'bg-primary-600 text-white shadow-md' : 'text-gray-400 hover:bg-gray-800 hover:text-white'}" do %>
          <svg class="mr-3 h-5 w-5 transition-colors duration-200 #{request.path.include?(cars_path) ? 'text-white' : 'text-gray-500 group-hover:text-gray-300'}" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          My Cars
        <% end %>
      <% end %>

      <p class="px-2 text-xs font-semibold text-gray-500 uppercase tracking-wider mt-8 mb-4">General</p>
      
      <%= link_to "#", class: "group flex items-center px-3 py-2.5 text-sm font-medium text-gray-400 rounded-lg transition-colors duration-200 hover:bg-gray-800 hover:text-white" do %>
        <svg class="mr-3 h-5 w-5 text-gray-500 group-hover:text-gray-300 transition-colors duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        Settings
      <% end %>
    </nav>

    <!-- User Profile / Upgrade -->
    <div class="p-4 border-t border-gray-800 bg-gray-900">
      <div class="flex items-center">
        <% if user_signed_in? %>
          <div class="flex items-center w-full px-2">
            <div class="flex-shrink-0">
               <span class="inline-block h-8 w-8 rounded-full bg-gray-700 flex items-center justify-center text-xs font-medium text-white ring-2 ring-gray-800">
                 <%= current_user.email.first.upcase %>
               </span>
            </div>
            <div class="ml-3 flex-1 min-w-0">
               <p class="text-sm font-medium text-white truncate"><%= current_user.email.split('@').first.capitalize %></p>
               <%= link_to 'Log Out', destroy_user_session_path, method: :delete, class: "text-xs font-medium text-gray-500 hover:text-gray-300 transition-colors duration-200" %>
            </div>
          </div>
        <% else %>
           <div class="space-y-1 w-full">
            <%= link_to 'Sign In', new_user_session_path, class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 transition-colors duration-200" %>
           </div>
        <% end %>
      </div>
    </div>
  </div>
</aside>
